{
  "name": "skill-optimizer",
  "version": "1.0.0",
  "description": "Optimalkan penggunaan skill OpenClaw: router otomatis (keyword TF-IDF + fallback LLM), injeksi konteks, tool rekomendasi, dan statistik pemakaian.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "test": "node --test test/run-tests.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.2.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.2.0"
    }
  },
  "keywords": [
    "openclaw",
    "plugin",
    "skills",
    "optimizer",
    "recommendation"
  ]
}